# StoryLab demo server — copy this file to .env, then uncomment the key line
# and paste your own value. .env is ignored by git.
# Create a key at https://console.groq.com/keys
#GROQ_API_KEY=paste_your_own_key_here

# Optional overrides
#GROQ_MODEL=llama-3.3-70b-versatile
#GROQ_BASE_URL=https://api.groq.com/openai/v1
#PORT=8123
