{
  "id": "/",
  "name": "StoryLab Voice — Learning Terminal",
  "short_name": "StoryLab",
  "description": "An offline-first field terminal for voice-guided stories, tutoring, and virtual science labs.",
  "start_url": "/#/home",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0a0c0b",
  "theme_color": "#0a0c0b",
  "lang": "en-IN",
  "dir": "ltr",
  "prefer_related_applications": false,
  "categories": ["education", "productivity"],
  "icons": [
    {
      "src": "icons/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "icons/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Control Deck",
      "short_name": "Deck",
      "description": "Open the learning bays",
      "url": "/#/home",
      "icons": [{ "src": "icons/icon-192.svg", "sizes": "192x192", "type": "image/svg+xml" }]
    },
    {
      "name": "Learning Record",
      "short_name": "Record",
      "description": "Open the student learning record",
      "url": "/#/record",
      "icons": [{ "src": "icons/icon-192.svg", "sizes": "192x192", "type": "image/svg+xml" }]
    }
  ]
}
